{#- Authfly sign-in on UI8Kit 3 primitives. Props (p): id, title, text, action, csrf, error, labels, providers,
    method (password|magic), identifier (any|email|username), social (none|show), landmarkLabel. -#}
{%- import 'authfly/components.html.twig' as af -%}
{%- set id = p.id ?? '' -%}{%- set l = p.labels ?? {} -%}{%- set error = p.error ?? '' -%}
{%- set email = (p.identifier ?? 'any') == 'email' -%}
{%- set formError = error ? id ~ '-error' : null -%}
{%- set providers -%}
{%- for pr in p.providers ?? [] -%}
{%- set c -%}{{ af.icon(pr.icon ?? '') }}{{ pr.title ?? '' }}{%- endset -%}
{{ af.button((l.socialUrl ?? '') ~ '/' ~ (pr.id ?? ''), '', af_skin('button', 'outline', 'w-full'), {'data-provider': pr.id ?? null}, c) }}
{%- endfor -%}
{%- endset -%}
{%- set form -%}
{{ af.hidden('csrf', p.csrf ?? '') }}
{{- af.field({label: l.identifier ?? '', for: id ~ '-identifier', formError: formError, input: {type: email ? 'email' : 'text', name: 'identifier', required: true, attrs: {autocomplete: email ? 'email' : 'username'}}}) }}
{%- if (p.method ?? 'password') == 'password' -%}
{{ af.field({label: l.password ?? '', for: id ~ '-password', formError: formError, input: {type: 'password', name: 'password', required: true, attrs: {autocomplete: 'current-password'}}}) }}
{%- if l.forgot ?? '' %}{{ af.link(l.forgotHref ?? '', af_skin('link', 'w-fit text-sm'), 'forgot', l.forgot) }}{% endif -%}
{%- endif -%}
{{ af.button('', 'submit', af_skin('button', 'default', 'w-full'), {'data-testid': 'submit'}, af_esc(l.submit ?? '')) }}
{%- endset -%}
{%- set body -%}
{{ af.head(id, p.title ?? '', p.text ?? '') }}
{{- af.messages(id, error, '') }}
{%- if (p.social ?? 'none') == 'show' %}{{ af.stack('2', '', '', '', {role: 'group', 'aria-label': l.providers ?? null, 'data-testid': 'authfly-providers'}, providers) }}{% endif -%}
{{ af.form(p.action ?? '', '', {'data-testid': 'authfly-form'}, form) }}
{%- if l.magic ?? '' %}{{ af.button(l.magicHref ?? '', '', af_skin('button', 'outline', 'w-full'), {'data-testid': 'switch-method'}, af_esc(l.magic)) }}{% endif -%}
{%- if l.signupLink ?? '' -%}
{%- set foot -%}{{ l.signupText ?? '' }} {{ af.link(l.signupHref ?? '', af_skin('link'), 'signup-link', l.signupLink) }}{%- endset -%}
{{ af.text('', af_text('muted'), {}, foot) }}
{%- endif -%}
{%- endset -%}
{{ af.card(af_skin('widgetCard'), {'data-testid': 'authfly-sign-in'}|merge({'aria-labelledby': (p.landmarkLabel ?? '') ? null : id ~ '-title', 'aria-label': p.landmarkLabel ?? null}), body) }}
