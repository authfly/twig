{#- Authfly OIDC consent on UI8Kit 3 primitives. Props (p): id, title, text, action, csrf, error, info, client,
    account, scopes, labels, landmarkLabel. -#}
{%- import 'authfly/components.html.twig' as af -%}
{%- set id = p.id ?? '' -%}{%- set l = p.labels ?? {} -%}
{%- set acc -%}{{ l.account ?? '' }} {{ af.text('strong', 'font-semibold', {}, af_esc(p.account ?? '')) }}{%- endset -%}
{%- set items -%}
{%- for s in p.scopes ?? [] -%}
{%- set c -%}{{ af.icon('check') }}{{ s.title ?? '' }}{%- endset -%}
{{ af.box('li', 'flex items-center gap-2 text-sm text-foreground', {'data-scope': s.id ?? null}, c) }}
{%- endfor -%}
{%- endset -%}
{%- set scopes -%}{{ af.title(2, id ~ '-scopes', '', l.scopes ?? '') }}{{ af.box('ul', 'm-0 flex list-none flex-col gap-2 p-0', {'aria-labelledby': id ~ '-scopes', 'data-testid': 'scopes'}, items) }}{%- endset -%}
{%- set deny -%}{{ af.hidden('csrf', p.csrf ?? '') }}{{ af.hidden('decision', 'deny') }}{{ af.button('', 'submit', af_skin('button', 'outline', 'w-full'), {}, af_esc(l.deny ?? '')) }}{%- endset -%}
{%- set approve -%}{{ af.hidden('csrf', p.csrf ?? '') }}{{ af.hidden('decision', 'approve') }}{{ af.button('', 'submit', af_skin('button', 'default', 'w-full'), {}, af_esc(l.approve ?? '')) }}{%- endset -%}
{%- set row -%}{{ af.form(p.action ?? '', 'flex-1', {'data-testid': 'deny'}, deny) }}{{ af.form(p.action ?? '', 'flex-1', {'data-testid': 'approve'}, approve) }}{%- endset -%}
{%- set body -%}
{{ af.head(id, p.title ?? '', p.text ?? '') }}
{{- af.messages(id, p.error ?? '', p.info ?? '') }}
{{- af.text('', 'text-sm text-foreground', {'data-testid': 'account'}, acc) }}
{{- af.stack('2', '', '', '', {}, scopes) }}
{{- af.group('2', '', 'between', '', {}, row) }}
{%- endset -%}
{{ af.card(af_skin('widgetCard'), {'data-testid': 'authfly-consent', 'data-client': p.client ?? null}|merge({'aria-labelledby': (p.landmarkLabel ?? '') ? null : id ~ '-title', 'aria-label': p.landmarkLabel ?? null}), body) }}
