{#- Authfly request on UI8Kit 3 primitives: kind email (forgot) | password (reset, token hidden) | code.
    Props (p): id, title, text, action, csrf, error, info, labels, token, kind, landmarkLabel. -#}
{%- import 'authfly/components.html.twig' as af -%}
{%- set id = p.id ?? '' -%}{%- set l = p.labels ?? {} -%}{%- set error = p.error ?? '' -%}
{%- set formError = error ? id ~ '-error' : null -%}
{%- set kind = p.kind ?? 'email' -%}
{%- set form -%}
{{ af.hidden('csrf', p.csrf ?? '') }}
{%- if kind == 'email' -%}
{{ af.field({label: l.field ?? '', for: id ~ '-email', formError: formError, input: {type: 'email', name: 'email', required: true, attrs: {autocomplete: 'email'}}}) }}
{%- elseif kind == 'password' -%}
{{ af.hidden('token', p.token ?? '') }}
{{- af.field({label: l.field ?? '', for: id ~ '-password', formError: formError, input: {type: 'password', name: 'password', required: true, attrs: {autocomplete: 'new-password'}}}) }}
{{- af.field({label: l.confirm ?? '', for: id ~ '-confirm', formError: formError, input: {type: 'password', name: 'confirm', required: true, attrs: {autocomplete: 'new-password'}}}) }}
{%- elseif kind == 'code' -%}
{{ af.field({label: l.field ?? '', for: id ~ '-code', formError: formError, input: {type: 'text', name: 'code', required: true, attrs: {inputmode: 'numeric', autocomplete: 'one-time-code'}}}) }}
{%- endif -%}
{{ af.button('', 'submit', af_skin('button', 'default', 'w-full'), {'data-testid': 'submit'}, af_esc(l.submit ?? '')) }}
{%- endset -%}
{%- set body -%}
{{ af.head(id, p.title ?? '', p.text ?? '') }}
{{- af.messages(id, error, p.info ?? '') }}
{{- af.form(p.action ?? '', '', {'data-testid': 'authfly-form'}, form) }}
{%- if l.back ?? '' %}{{ af.link(l.backHref ?? '', af_skin('link', 'w-fit text-sm'), 'back', l.back) }}{% endif -%}
{%- endset -%}
{{ af.card('', {'data-testid': 'authfly-request'}|merge({'aria-labelledby': (p.landmarkLabel ?? '') ? null : id ~ '-title', 'aria-label': p.landmarkLabel ?? null}), body) }}
