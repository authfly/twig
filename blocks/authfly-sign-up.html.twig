{#- Authfly sign-up on UI8Kit 3 primitives. Props (p): id, title, text, action, csrf, error, info, labels,
    terms (show|none), landmarkLabel. -#}
{%- import 'authfly/components.html.twig' as af -%}
{%- set id = p.id ?? '' -%}{%- set l = p.labels ?? {} -%}{%- set error = p.error ?? '' -%}
{%- set formError = error ? id ~ '-error' : null -%}
{%- set domain = l.domain ?? '' -%}
{%- set suffix -%}{% if domain %}{{ af.text('span', af_text('muted'), {id: id ~ '-domain', 'data-testid': 'domain'}, af_esc(domain)) }}{% endif %}{%- endset -%}
{%- set form -%}
{{ af.hidden('csrf', p.csrf ?? '') }}
{{- af.field({label: l.name ?? '', for: id ~ '-name', formError: formError, input: {type: 'text', name: 'name', attrs: {autocomplete: 'name'}}}) }}
{{- af.field({label: l.username ?? '', for: id ~ '-username', formError: formError, describe: domain ? id ~ '-domain' : null, suffix: suffix, input: {type: 'text', name: 'username', required: true, attrs: {autocomplete: 'username'}}}) }}
{{- af.field({label: l.password ?? '', for: id ~ '-password', hint: l.hint ?? '', formError: formError, input: {type: 'password', name: 'password', required: true, attrs: {autocomplete: 'new-password'}}}) }}
{%- if (p.terms ?? 'show') == 'show' -%}
{%- set t -%}
{{ include('ui/checkbox/Checkbox.html.twig', {name: 'terms', required: true, id: id ~ '-terms', class: af_skin('checkbox')}, with_context = false) }}
{{- include('ui/label/Label.html.twig', {htmlFor: id ~ '-terms', class: af_skin('label', 'font-normal'), children: af_esc(l.terms ?? '')}, with_context = false) }}
{%- endset -%}
{{ af.group('2', '', '', 'w-fit', {}, t) }}
{%- endif -%}
{{ af.button('', 'submit', af_skin('button', 'default', 'w-full'), {'data-testid': 'submit'}, af_esc(l.submit ?? '')) }}
{%- endset -%}
{%- set body -%}
{{ af.head(id, p.title ?? '', p.text ?? '') }}
{{- af.messages(id, error, p.info ?? '') }}
{{- af.form(p.action ?? '', '', {'data-testid': 'authfly-form'}, form) }}
{%- if l.signinLink ?? '' -%}
{%- set foot -%}{{ l.signinText ?? '' }} {{ af.link(l.signinHref ?? '', af_skin('link'), 'signin-link', l.signinLink) }}{%- endset -%}
{{ af.text('', af_text('muted'), {}, foot) }}
{%- endif -%}
{%- endset -%}
{{ af.card(af_skin('widgetCard'), {'data-testid': 'authfly-sign-up'}|merge({'aria-labelledby': (p.landmarkLabel ?? '') ? null : id ~ '-title', 'aria-label': p.landmarkLabel ?? null}), body) }}
